{
  "name": "deep-vault",
  "version": "4.2.5",
  "description": "AI-powered research assistant for Obsidian using Claude",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "node scripts/deploy.js"
  },
  "keywords": [
    "obsidian",
    "claude",
    "ai",
    "research"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "vitest": "^3.0.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.12.3",
    "tslib": "2.4.0",
    "typescript": "4.7.4"
  }
}
